# Copy to .env and fill in. Never commit .env.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mechanic
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Public URL used in activation e-mails
APP_BASE_URL=http://localhost:8080

# Optional. Creates the "admin" account on startup, or re-enables it if disabled (min. 8 characters).
# Leave EMPTY unless you set your own strong password: never ship a sample value.
ADMIN_PASSWORD=

# E-mail. Out of the box mails go to the local Mailpit from docker-compose (SMTP localhost:1025,
# inbox at http://localhost:8025), so nothing below is needed for development.
# To use a real SMTP server of your choice, uncomment and fill in:
# SPRING_MAIL_HOST=smtp.example.org
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_STARTTLS=true
# MAIL_FROM=noreply@example.org

# https://www.google.com/recaptcha/admin (v2 checkbox). The site key lives in templates/parts/login.ftlh
RECAPTCHA_SECRET=your-recaptcha-secret
