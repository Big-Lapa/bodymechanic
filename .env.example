# Copy to .env and fill in. Never commit .env.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mechanic
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Public URL used in activation e-mails
APP_BASE_URL=http://localhost:8080

# Optional. Creates the "admin" account on startup, or re-enables it if disabled (min. 8 characters).
# Leave EMPTY unless you set your own strong password: never ship a sample value.
ADMIN_PASSWORD=

SPRING_MAIL_HOST=smtp.yandex.ru
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=you@example.org
SPRING_MAIL_PASSWORD=app-password

# https://www.google.com/recaptcha/admin (v2 checkbox). The site key lives in templates/parts/login.ftlh
RECAPTCHA_SECRET=your-recaptcha-secret
